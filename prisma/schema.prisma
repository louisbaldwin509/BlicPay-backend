generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" for production — see README.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  passwordHash String
  role         String    @default("member") // "member" | "admin"
  balance      Int       @default(0)        // stored as integer HTG (no decimals)
  createdAt    DateTime  @default(now())
  deposits     Deposit[]
}

model Deposit {
  id          String    @id @default(cuid())
  userId      String
  amount      Int
  method      String    // "moncash" | "natcash" | "usdt" | "zelle" | "biwo"
  status      String    @default("pending") // "pending" | "confirmed" | "rejected"
  reference   String    @unique
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  confirmedBy String?
  user        User      @relation(fields: [userId], references: [id])
}

// Yon biznis ki vle resevwa peman via BLICPay sou pwòp sit entènèt li.
model Merchant {
  id              String           @id @default(cuid())
  businessName    String
  email           String           @unique
  passwordHash    String
  website         String?
  publicKey       String           @unique // safe pou mete nan kòd front-end sit marchan an
  secretKey       String           @unique // SEELMAN sèvè marchan an — pa janm nan front-end
  webhookUrl      String?          // BLICPay rele URL sa a lè yon peman konfime
  balance         Int              @default(0) // total HTG marchan an resevwa (kredite lè peman konfime)
  createdAt       DateTime         @default(now())
  paymentRequests PaymentRequest[]
}

// Yon "demand peman" marchan an kreye pou yon acha espesifik.
// Kliyan BLICPay a konfime li soti nan sòld li — sa vin kredite balans marchan an
// (nou swiv sa nan `merchantBalance` sou Merchant si w vle, oswa yon ledger apa pita).
model PaymentRequest {
  id          String    @id @default(cuid())
  merchantId  String
  amount      Int
  currency    String    @default("HTG")
  reference   String    // referans entèn marchan an bay (ID kòmand li, elatriye)
  description String?
  status      String    @default("pending") // "pending" | "paid" | "expired" | "cancelled"
  payerUserId String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
}
